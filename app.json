{
  "name": "auto-movies-bot",
  "description": "Professional Telegram Auto Movies Bot",
  "keywords": ["telegram", "telegram-bot", "movies-bot"],
  "repository": "https://github.com/Akatsumo/Auto-Movies-Bot",
  "success_url": "https://t.me/DevsHubChat",
  "env": {
    "API_ID": {
      "description": "Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash from my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Bot token from BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Telegram User ID of the owner",
      "required": true
    },
    "MONGO_DB": {
      "description": "MongoDB connection URI (MongoDB Atlas recommended)",
      "required": true
    },
    "CHANNEL_URL": {
      "description": "Telegram channel URL e.g. https://t.me/yourchannel",
      "required": true
    },
    "CHANNEL_IDS": {
      "description": "Comma separated channel IDs for force subscribe e.g. -1001234567890,-1009876543210",
      "required": true
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
